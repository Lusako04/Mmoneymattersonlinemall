/* styles.css */
body {
    background: #f8fafc;
    font-family: 'Inter', Arial, sans-serif;
    margin: 0;
    padding: 0;
    color: #222;
}

.container {
    max-width: 900px;
    margin: 40px auto;
    background: #fff;
    border-radius: 20px;
    box-shadow: 0 4px 32px rgba(30, 41, 59, 0.08);
    padding: 32px 24px;
}

h1 {
    font-size: 2.2rem;
    font-weight: 700;
    margin-bottom: 8px;
    text-align: center;
}

.subtitle {
    text-align: center;
    color: #a81010;
    margin-bottom: 28px;
    font-size: 1rem;
}

.trip-filters {
    display: flex;
    justify-content: center;
    gap: 18px;
    margin-bottom: 32px;
}

.trip-filters

.filter {
    background: #f1f5f9;
    border: none;
    border-radius: 999px;
    padding: 12px 32px;
    font-size: 1.1rem;
    font-weight: 500;
    cursor: pointer;
    color: #8a0a0a;
    transition: background 0.2s, color 0.2s;
}

.filter.active, .filter:hover {
    background: #e0f2fe;
    color: #0284c7;
}

.bus-list {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.bus-card {
    display: flex;
    align-items: center;
    background: #f1f5f9;
    border-radius: 18px;
    padding: 20px 24px;
    box-shadow: 0 2px 8px rgba(30, 41, 59, 0.03);
    gap: 18px;
    position: relative;
}

.bus-card.highlighted {
    background: #e0f2fe;
    border: 2px solid #bae6fd;
}

.bus-info {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 220px;
    flex: 1 1 0;
}

.bus-logo {
    width: 70px;
    height: auto;
    margin-right: 10px;
}

.depart-time, .arrive-time {
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e293b;
}

.depart-location, .arrive-location {
    font-size: 0.98rem;
    color: #64748b;
    margin-top: 2px;
}

.arrow {
    font-size: 2.2rem;
    color: #38bdf8;
    margin: 0 12px;
}

.bus-price {
    margin-left: auto;
    background: #f1f5f9;
    border-radius: 999px;
    padding: 14px 32px;
    font-size: 1.3rem;
    font-weight: 600;
    color: #0ea5e9;
    box-shadow: 0 1px 4px rgba(30, 41, 59, 0.04);
    transition: background 0.2s;
}

@media (max-width: 700px) {
    .container {
        padding: 12px 4px;
    }
    .bus-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
        padding: 14px 8px;
    }
    .bus-info {
        min-width: 0;
        gap: 8px;
    }
    .bus-price {
        margin-left: 0;
        margin-top: 10px;
        width: 100%;
        text-align: right;
    }
}
